{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "800px",
      "wideSize": "1280px"
    },
    "color": {
      "palette": [
        {
          "slug": "dark",
          "color": "#0F1923",
          "name": "Dark"
        },
        {
          "slug": "light",
          "color": "#F5F2EC",
          "name": "Light"
        },
        {
          "slug": "accent",
          "color": "#26AFFF",
          "name": "Accent Blue"
        },
        {
          "slug": "accent-secondary",
          "color": "#C8A96E",
          "name": "Accent Gold"
        },
        {
          "slug": "mid-dark",
          "color": "#2A3A47",
          "name": "Mid Dark"
        },
        {
          "slug": "muted",
          "color": "#7A8B95",
          "name": "Muted"
        },
        {
          "slug": "off-white",
          "color": "#E8E5DF",
          "name": "Off White"
        },
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "White"
        },
        {
          "slug": "black",
          "color": "#000000",
          "name": "Black"
        }
      ],
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "gradients": [
        {
          "slug": "dark-to-mid",
          "gradient": "linear-gradient(135deg, #0F1923 0%, #2A3A47 100%)",
          "name": "Dark to Mid"
        },
        {
          "slug": "accent-glow",
          "gradient": "radial-gradient(ellipse at center, rgba(38,175,255,0.15) 0%, transparent 70%)",
          "name": "Accent Glow"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "montserrat",
          "name": "Montserrat",
          "fontFamily": "'Montserrat', sans-serif",
          "fontFace": [
            {
              "fontFamily": "Montserrat",
              "fontWeight": "400 900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/montserrat-latin-ext.woff2"
              ],
              "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
            },
            {
              "fontFamily": "Montserrat",
              "fontWeight": "400 900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/montserrat-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "open-sans",
          "name": "Open Sans",
          "fontFamily": "'Open Sans', sans-serif",
          "fontFace": [
            {
              "fontFamily": "Open Sans",
              "fontWeight": "300 800",
              "fontStyle": "normal",
              "src": [
                "https://fonts.gstatic.com/s/opensans/v36/memSYaGs126MiZpBA-UvWbX2vVnXBbObj2OVZyOOSr4dVJWUgsjZ0C24.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "size": "0.75rem",
          "name": "XS"
        },
        {
          "slug": "sm",
          "size": "0.875rem",
          "name": "SM"
        },
        {
          "slug": "base",
          "size": "1rem",
          "name": "Base"
        },
        {
          "slug": "md",
          "size": "1.125rem",
          "name": "MD"
        },
        {
          "slug": "lg",
          "size": "1.25rem",
          "name": "LG"
        },
        {
          "slug": "xl",
          "size": "1.5rem",
          "name": "XL"
        },
        {
          "slug": "2xl",
          "size": "2rem",
          "name": "2XL"
        },
        {
          "slug": "3xl",
          "size": "2.5rem",
          "name": "3XL"
        },
        {
          "slug": "4xl",
          "size": "3.5rem",
          "name": "4XL"
        },
        {
          "slug": "5xl",
          "size": "clamp(2.5rem, 6vw, 5rem)",
          "name": "5XL"
        },
        {
          "slug": "hero",
          "size": "clamp(3rem, 8vw, 7rem)",
          "name": "Hero"
        }
      ],
      "fluid": true,
      "customFontSize": true
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "size": "0.25rem",
          "name": "1"
        },
        {
          "slug": "2",
          "size": "0.5rem",
          "name": "2"
        },
        {
          "slug": "3",
          "size": "0.75rem",
          "name": "3"
        },
        {
          "slug": "4",
          "size": "1rem",
          "name": "4"
        },
        {
          "slug": "5",
          "size": "1.25rem",
          "name": "5"
        },
        {
          "slug": "6",
          "size": "1.5rem",
          "name": "6"
        },
        {
          "slug": "8",
          "size": "2rem",
          "name": "8"
        },
        {
          "slug": "10",
          "size": "2.5rem",
          "name": "10"
        },
        {
          "slug": "12",
          "size": "3rem",
          "name": "12"
        },
        {
          "slug": "16",
          "size": "4rem",
          "name": "16"
        },
        {
          "slug": "20",
          "size": "5rem",
          "name": "20"
        },
        {
          "slug": "24",
          "size": "6rem",
          "name": "24"
        },
        {
          "slug": "32",
          "size": "8rem",
          "name": "32"
        }
      ],
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ],
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "presets": [
        {
          "slug": "soft",
          "shadow": "0 4px 24px rgba(0,0,0,0.25)",
          "name": "Soft"
        },
        {
          "slug": "accent",
          "shadow": "0 0 32px rgba(38,175,255,0.25)",
          "name": "Accent Glow"
        },
        {
          "slug": "strong",
          "shadow": "0 8px 48px rgba(0,0,0,0.5)",
          "name": "Strong"
        }
      ]
    },
    "custom": {
      "transition": {
        "base": "0.3s cubic-bezier(0.4,0,0.2,1)",
        "slow": "0.6s cubic-bezier(0.4,0,0.2,1)"
      }
    }
  },
  "styles": {
    "color": {
      "background": "#0F1923",
      "text": "#F5F2EC"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--open-sans)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.7"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--8)"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--montserrat)",
          "fontWeight": "900",
          "lineHeight": "1.1",
          "letterSpacing": "-0.02em"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--montserrat)",
          "fontWeight": "800",
          "lineHeight": "1.2",
          "letterSpacing": "-0.015em"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--montserrat)",
          "fontWeight": "600",
          "lineHeight": "1.3"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--light)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "#0F1923"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--montserrat)",
          "fontWeight": "700",
          "letterSpacing": "0.05em"
        },
        "border": {
          "radius": "25px"
        },
        "spacing": {
          "padding": {
            "top": ".5rem",
            "right": "1rem",
            "bottom": ".5rem",
            "left": "1rem"
          }
        }
      }
    },
    "blocks": {
      "core/group": {
        "spacing": {
          "padding": {
            "top": "0",
            "right": "0",
            "bottom": "0",
            "left": "0"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "header-quiz",
      "title": "Header Quiz",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "blank",
      "title": "Blank",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "landing",
      "title": "Landing Page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "quiz",
      "title": "Quiz Diagnóstico",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "brand-discovery",
      "title": "Brand Discovery",
      "postTypes": [
        "page"
      ]
    }
  ],
  "patterns": []
}